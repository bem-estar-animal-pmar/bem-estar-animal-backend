# Connection string  ou URL do banco de dados
DATABASE_URL="postgresql://username:password@localhost:5432/bem_estar_animal?schema=public"

# A porta do backend, padrão 4000
PORT=4000

#  "development" ou "production"
NODE_ENV="development"

# Configuração de origens permitidas, em produção colocar um array com o url do frontend.
ALLOWED_CORS_URLS='["http://localhost:3000"]'

# Em produção coloque aqui o endereço do backend.
BETTER_AUTH_URL="http://localhost:4000"

# Gere uma string de 32 em hex caracteres e insira aqui.
BETTER_AUTH_SECRET="your_better_auth_secret_here"

# Caso use proxy com a cloudflare, coloque "cloudflare", caso contrário mantenha vazio.
PROXY_CONNECTED=""

# API Key do resend para enviar e-mails.
RESEND_API_KEY="re_your_resend_api_key_here"

# Variáveis de configuração do Bucket da Cloudflare R2.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="sua_id_key_de_acesso_do_r2"
R2_SECRET_ACCESS_KEY="sua_access_key_de_acesso_do_r2"
R2_BUCKET_NAME="nome-do-bucket-criado"
R2_PUBLIC_URL="https://seu-bucket-id.r2.dev"

# Credenciais da conta inicial de administrador à ser criada com o comando de seeding.
SEED_ADMIN_EMAIL="admin@bemestaranimal.com"
SEED_ADMIN_PASSWORD="YourAdminSecurePassword123!"
