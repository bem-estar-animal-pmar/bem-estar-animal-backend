// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MANAGER
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  history       String    @db.VarChar(4000)   @default("")

  role          Role      @default(USER)
  lastName      String
  cpf           String    @unique
  phone         String

  cep           String
  street        String
  neighborhood  String
  city          String
  state         String
  number        String

  termsAcceptedAt     DateTime?  @default(now())
  termsVersion        String    // "v1.0.0"
  
  privacyAcceptedAt     DateTime?  @default(now())
  privacyVersion        String    // "v1.0.0"

  blockedUntil     DateTime? /* in case user does not show for appointment */
  deletedAt       DateTime? /* when user request account deletion */

  /* relations */
  pets                     Pet[]
  neuteringAppointments    NeuteringAppointment[]
  emergencyAppointments    EmergencyAppointment[]
  giveupRequests           GiveUpRequest[]
  
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/* ----------------- BETTER-AUTH UNRELATED MODELS ----------------- */

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum PetHomeStatus { 
  HAS_OWNER 
  TEMPORARY_HOME
  STRAY_ANIMAL /* set this if the animal is sent back to the streets */
}

enum PetAdoptionStatus { 
  FOR_ADOPTION
  ADOPTED
  NONE
}

enum PetBreed {
  AKITA
  AMERICAN_STAFFORDSHIRE_TERRIER
  AMERICAN_BULLY
  BASSET_HOUND
  BEAGLE
  AUSTRALIAN_CATTLE_DOG
  BERNESE_MOUNTAIN_DOG
  BORDER_COLLIE
  BORDER_TERRIER
  BOSTON_TERRIER
  BOXER
  FRENCH_BULLDOG
  ENGLISH_BULLDOG
  BULL_TERRIER
  CANE_CORSO
  CAVALIER_KING_CHARLES_SPANIEL
  CHIHUAHUA
  CHOW_CHOW
  AMERICAN_COCKER_SPANIEL
  ENGLISH_COCKER_SPANIEL
  COLLIE
  DACHSHUND
  DALMATIAN
  DOBERMAN
  DOGO_ARGENTINO
  GREAT_DANE
  FILA_BRASILEIRO
  FOX_TERRIER
  GOLDEN_RETRIEVER
  SIBERIAN_HUSKY
  JACK_RUSSELL_TERRIER
  LABRADOODLE
  LABRADOR_RETRIEVER
  LHASA_APSO
  POMERANIAN
  MALTESE
  GERMAN_SHEPHERD
  AUSTRALIAN_SHEPHERD
  MINIATURE_PINSCHER
  PIT_BULL
  POODLE
  PUG
  ROTTWEILER
  SHIH_TZU
  STAFFORDSHIRE_BULL_TERRIER
  NEWFOUNDLAND
  SCOTTISH_TERRIER
  WEIMARANER
  WELSH_CORGI
  YORKSHIRE_TERRIER

  ABYSSINIAN
  ANGORA
  BENGAL
  BIRMAN
  CHARTREUX
  RUSSIAN_BLUE
  HIMALAYAN
  MAINE_COON
  MUNCHKIN
  SPHYNX
  SIAMESE
  RAGDOLL
  SCOTTISH_FOLD
  AMERICAN_BURMESE
  PERSIAN
  EXOTIC_SHORTHAIR

  MIXED_BREED
}

model Pet {
  id                String             @id @default(cuid())
  name              String
  species           PetSpecies
  gender            PetGender
  birthDate         DateTime         
  breed             PetBreed           @default(MIXED_BREED) // 'poodle'
  weight            Float              // kg
  size              PetSize
  coatColor         String             // color
  isNeutered        Boolean   @default(false)
  allowEmergency    Boolean   @default(false) /* field for admins to create pets and set to allow owners to request emergencies */
  
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])

  homeStatus        PetHomeStatus      @default(HAS_OWNER) /* STRAY_ANIMAL is set when the pet was sent back to streets,
  this might happen when the clinic threated a pet or someone who does not own it asked for consultation */
  adoptionStatus    PetAdoptionStatus  @default(NONE)
  chip              String             @default("NO_CHIP") /* chip can only be set by the clinic */

  neuteringAppointments NeuteringAppointment[]
  emergencyAppointments EmergencyAppointment[]
  giveupRequests        GiveUpRequest[]
  adoptionRequests      AdoptionRequest[]

  /* medicalRecords should be also here so it is easier to retrieve data */
  medicalRecords        MedicalRecord[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
}

enum NeuteringStatus {
  PENDING
  AWAITING_EXAMS
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EmergencyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model NeuteringAppointment {
  id            String          @id @default(uuid())
  requestNumber Int             @unique @default(autoincrement())
  status        NeuteringStatus @default(PENDING)

  scheduleDate  DateTime?        /* date only uses day, we do not check time */
  period        String?          /* time is based only on period */

  userId        String
  user          User            @relation(fields: [userId], references: [id])

  petId         String          
  pet           Pet             @relation(fields: [petId], references: [id])
  
  animalFastAccepted    Boolean   @default(false)
  animalChipAccepted    Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  medicalRecord MedicalRecord?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model EmergencyAppointment {
  id              String          @id @default(uuid())
  requestNumber   Int             @unique @default(autoincrement())
  status          EmergencyStatus @default(PENDING)

  name            String
  species         PetSpecies
  gender          PetGender?
  size            PetSize
  description     String?         @db.VarChar(1000)

  triageData      Json?
  
  /* date and period are defined by the clinic */
  scheduleDate    DateTime?
  period          String?

  userId          String          /* user will be temporary home for at least the time of the treatment */
  user            User            @relation(fields: [userId], references: [id])

  /* after the appointment, the clinic will create a pet (for the user or not, and attatch to the emergency) */
  petId     String?         
  pet       Pet?            @relation(fields: [petId], references: [id])

  temporaryHomeAccepted Boolean   @default(false)
  animalChipAccepted    Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  medicalRecord   MedicalRecord?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MedicalRecord {
  id                      String   @id @default(uuid())
  history                 String   @db.VarChar(8000) /* to set change appointment history status */
  notes                   String   @db.VarChar(8000)

  petId                   String?   
  pet                     Pet?      @relation(fields: [petId], references: [id])
  
  neuteringAppointmentId  String?  @unique
  neuteringAppointment    NeuteringAppointment? @relation(fields: [neuteringAppointmentId], references: [id])

  emergencyAppointmentId  String?  @unique
  emergencyAppointment    EmergencyAppointment? @relation(fields: [emergencyAppointmentId], references: [id])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?
}

/* ----------------- ADOPTION REQUESTS AND GIVE UP MODELS ----------------- */

enum GiveUpRequestStatus { /* there is no cancelled here, cancel route just delete the data row from the db */
  PENDING
  APPROVED           /* for give it is active state */
  REJECTED
}

enum AdoptionRequestStatus { /* not here also, because adoption requests are sent without login */
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model GiveUpRequest {
  id        String        @id @default(uuid())
  requestNumber Int             @unique @default(autoincrement())
  status    GiveUpRequestStatus @default(PENDING)
  reason    String?       @db.VarChar(8000)
  history   String        @db.VarChar(2000)
  
  petId     String
  pet       Pet           @relation(fields: [petId], references: [id])
  
  userId    String
  user      User          @relation(fields: [userId], references: [id])

  approvedAt DateTime?     

  temporaryHomeAccepted Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  createdAt DateTime      @default(now())
}

model AdoptionRequest {
  id            String        @id @default(uuid())
  requestNumber Int             @unique @default(autoincrement())
  status        AdoptionRequestStatus @default(PENDING)
  history   String        @db.VarChar(2000)
  
  petId         String
  pet           Pet           @relation(fields: [petId], references: [id])

  adopterName   String
  adopterEmail  String
  adopterPhone  String
  
  adopterCep           String
  adopterStreet        String
  adopterNeighborhood  String
  adopterCity          String
  adopterState         String
  adopterNumber        String
  
  termsAccepted         Boolean   @default(false)

  adoptedAt DateTime?     

  createdAt     DateTime      @default(now())
}

model NeuteringConfig {
  id                    Int @id @default(1)
  weekdayMorningLimit   Int @default(12)
  weekdayAfternoonLimit Int @default(6)
  fridayMorningLimit    Int @default(20)
  fridayAfternoonLimit  Int @default(7)
  updatedAt             DateTime @updatedAt
}