// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role          Role      @default(USER)
  lastName      String
  cpf           String    /* cpf is unique */
  cep           String
  phone         String

  blockedUntil     DateTime? /* in case user does not show for appointment */

  /* relations */
  pets                     Pet[]
  neuteringAppointments    NeuteringAppointment[]
  emergencyAppointments    EmergencyAppointment[]
  giveupRequests           GiveUpRequest[]
  
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/* ----------------- BETTER-AUTH UNRELATED MODELS ----------------- */

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum PetAdoptionStatus { 
  FOR_ADOPTION
  ADOPTED
  HAS_OWNER 
  TEMPORARY_HOME
  STRAY_ANIMAL /* set this if the animal is sent back to the streets */
}

enum PetBreed {
  AKITA
  AMERICAN_STAFFORDSHIRE_TERRIER
  AMERICAN_BULLY
  BASSET_HOUND
  BEAGLE
  AUSTRALIAN_CATTLE_DOG
  BERNESE_MOUNTAIN_DOG
  BORDER_COLLIE
  BORDER_TERRIER
  BOSTON_TERRIER
  BOXER
  FRENCH_BULLDOG
  ENGLISH_BULLDOG
  BULL_TERRIER
  CANE_CORSO
  CAVALIER_KING_CHARLES_SPANIEL
  CHIHUAHUA
  CHOW_CHOW
  AMERICAN_COCKER_SPANIEL
  ENGLISH_COCKER_SPANIEL
  COLLIE
  DACHSHUND
  DALMATIAN
  DOBERMAN
  DOGO_ARGENTINO
  GREAT_DANE
  FILA_BRASILEIRO
  FOX_TERRIER
  GOLDEN_RETRIEVER
  SIBERIAN_HUSKY
  JACK_RUSSELL_TERRIER
  LABRADOODLE
  LABRADOR_RETRIEVER
  LHASA_APSO
  POMERANIAN
  MALTESE
  GERMAN_SHEPHERD
  AUSTRALIAN_SHEPHERD
  MINIATURE_PINSCHER
  PIT_BULL
  POODLE
  PUG
  ROTTWEILER
  SHIH_TZU
  STAFFORDSHIRE_BULL_TERRIER
  NEWFOUNDLAND
  SCOTTISH_TERRIER
  WEIMARANER
  WELSH_CORGI
  YORKSHIRE_TERRIER

  ABYSSINIAN
  ANGORA
  BENGAL
  BIRMAN
  CHARTREUX
  RUSSIAN_BLUE
  HIMALAYAN
  MAINE_COON
  MUNCHKIN
  SPHYNX
  SIAMESE
  RAGDOLL
  SCOTTISH_FOLD
  AMERICAN_BURMESE
  PERSIAN
  EXOTIC_SHORTHAIR

  MIXED_BREED
}

model Pet {
  id                String             @id @default(cuid())
  name              String
  species           PetSpecies
  gender            PetGender
  birthDate         DateTime         
  breed             PetBreed             @default(MIXED_BREED) // 'poodle'
  weight            Float              // kg
  size              PetSize
  coatColor         String             // color
  
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])

  adoptionStatus    PetAdoptionStatus  @default(HAS_OWNER) /* STRAY_ANIMAL is set when the pet was sent back to streets,
  this might happen when the clinic threated a pet or someone who does not own it asked for consultation */
  chip              String             @default("NO_CHIP") /* chip can only be set by the clinic */

  neuteringAppointments NeuteringAppointment[]
  emergencyAppointments EmergencyAppointment[]
  giveupRequests        GiveUpRequest[]
  adoptionRequests      AdoptionRequest[]

  /* medicalRecords should be also here so it is easier to retrieve data */
  medicalRecords        MedicalRecord[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
}

enum NeuteringStatus {
  PENDING
  AWAITING_EXAMS
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EmergencyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model NeuteringAppointment {
  id            String          @id @default(uuid())
  status        NeuteringStatus @default(PENDING)
  scheduleDate  DateTime        /* date only uses day, we do not check time */
  period        String          /* time is based only on period */

  userId        String
  user          User            @relation(fields: [userId], references: [id])

  petId         String          
  pet           Pet             @relation(fields: [petId], references: [id])

  
  animalFastAccepted    Boolean   @default(false)
  animalChipAccepted    Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  medicalRecord MedicalRecord?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model EmergencyAppointment {
  id              String          @id @default(uuid())
  status          EmergencyStatus @default(PENDING)

  species         PetSpecies
  size            PetSize
  description     String?         @db.Text
  
  /* date and period are defined by the clinic */
  scheduleDate    DateTime?
  period          String?

  userId          String          /* user will be temporary home for at least the time of the treatment */
  user            User            @relation(fields: [userId], references: [id])

  /* after the appointment, the clinic will create a pet (for the user or not, and attatch to the emergency) */
  petId     String?         
  pet       Pet?            @relation(fields: [petId], references: [id])

  temporaryHomeAccepted Boolean   @default(false)
  animalChipAccepted    Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  medicalRecord   MedicalRecord?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MedicalRecord {
  id                      String   @id @default(uuid())
  adminId                 String   // Veterinário
  notes                   String   @db.Text

  petId                   String   
  pet                     Pet      @relation(fields: [petId], references: [id])
  
  neuteringAppointmentId  String?  @unique
  neuteringAppointment    NeuteringAppointment? @relation(fields: [neuteringAppointmentId], references: [id])

  emergencyAppointmentId  String?  @unique
  emergencyAppointment    EmergencyAppointment? @relation(fields: [emergencyAppointmentId], references: [id])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/* ----------------- ADOPTION REQUESTS AND GIVE UP MODELS ----------------- */

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED_BY_USER
}

model GiveUpRequest {
  id        String        @id @default(uuid())
  status    RequestStatus @default(PENDING)
  reason    String?       @db.Text
  
  petId     String        @unique
  pet       Pet           @relation(fields: [petId], references: [id])
  
  userId    String
  user      User          @relation(fields: [userId], references: [id])

  temporaryHomeAccepted Boolean   @default(false)
  termsAccepted         Boolean   @default(false)

  createdAt DateTime      @default(now())
}

model AdoptionRequest {
  id            String        @id @default(uuid())
  status        RequestStatus @default(PENDING)
  
  petId         String
  pet           Pet           @relation(fields: [petId], references: [id])

  adopterName   String
  adopterEmail  String
  adopterPhone  String

  createdAt     DateTime      @default(now())
}