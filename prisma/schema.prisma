// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
}

enum PetAdoptionStatus { 
  FOR_ADOPTION
  ADOPTED
  HAS_OWNER 
  STRAY_ANIMAL /* set this if the animal is sent back to the streets */
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum NeuteringStatus {
  PENDING
  AWAITING_EXAMS
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EmergencyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role          Role      @default(USER)
  lastName      String
  cpf           String    /* cpf is unique */
  cep           String
  phone         String

  blockedUntil     DateTime? /* in case user does not show for appointment */

  /* relations */
  pets              Pet[]
  neuteringAppointments NeuteringAppointment[]
  emergencyAppointments EmergencyAppointment[]
  
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/* ----------------- BETTER-AUTH UNRELATED MODELS ----------------- */

model Pet {
  id                String             @id @default(cuid())
  name              String
  species           PetSpecies
  gender            PetGender
  birthDate         DateTime         
  breed             String             @default("NO_DEFINED_BREED") // 'poodle'
  weight            Float              // kg
  coatColor         String             // color
  
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])
  isTemporaryHome   Boolean            @default(false) /* set true if pet is for adoption (or owner is a temporary home, like ONGs) */

  adoptionStatus    PetAdoptionStatus  @default(HAS_OWNER) /* STRAY_ANIMAL is set when the pet was sent back to streets,
  this might happen when the clinic threated a pet or someone who does not own it asked for consultation */
  chip              String             @default("NO_CHIP") /* chip can only be set by the clinic */

  /*
  appointments     Appointment[]
  adoptionRequests AdoptionRequest[]
  */

  neuteringAppointments NeuteringAppointment[]
  emergencyAppointments EmergencyAppointment[]

  /* medicalRecords should be also here so it is easier to retrieve data */
  medicalRecords        MedicalRecord[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
}

model NeuteringAppointment {
  id            String          @id @default(uuid())
  status        NeuteringStatus @default(PENDING)
  scheduleDate  DateTime        /* date only uses day, we do not check time */
  period        String          /* time is based only on period */

  userId        String
  user          User            @relation(fields: [userId], references: [id])

  petId         String          
  pet           Pet             @relation(fields: [petId], references: [id])

  medicalRecord MedicalRecord?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model EmergencyAppointment {
  id              String          @id @default(uuid())
  status          EmergencyStatus @default(PENDING)
  
  // O usuário informa apenas o básico, o pet ainda não existe
  species         PetSpecies
  size            AnimalSize
  description     String?         @db.Text
  
  /* date and period are defined by the clinic */
  scheduleDate    DateTime?
  period          String?

  userId          String          /* user will be temporary home for at least the time of the treatment */
  user            User            @relation(fields: [userId], references: [id])

  /* after the appointment, the clinic will create a pet (for the user or not, and attatch to the emergency) */
  resultPetId     String?         @unique
  resultPet       Pet?            @relation(fields: [resultPetId], references: [id])

  medicalRecord   MedicalRecord?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MedicalRecord {
  id                      String   @id @default(uuid())
  adminId                 String   // Veterinário
  notes                   String   @db.Text

  petId                   String   
  pet                     Pet      @relation(fields: [petId], references: [id])
  
  neuteringAppointmentId  String?  @unique
  neuteringAppointment    NeuteringAppointment? @relation(fields: [neuteringAppointmentId], references: [id])

  emergencyAppointmentId  String?  @unique
  emergencyAppointment    EmergencyAppointment? @relation(fields: [emergencyAppointmentId], references: [id])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
